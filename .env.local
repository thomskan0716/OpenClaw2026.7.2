# OpenClaw Local Development Environment Configuration
# =======================================================
# This file is for LOCAL DEVELOPMENT ONLY
# Keep this file out of version control (add to .gitignore)
#
# Usage:
#   docker compose -f docker-compose.local.yml --env-file .env.local up -d
#
# Last Updated: 2026-08-12

# =============================================================================
# GATEWAY CONFIGURATION
# =============================================================================

# Gateway Authentication Token (REQUIRED for non-loopback binding)
# Generate with: openssl rand -hex 32
# Leave blank to auto-generate on first start
OPENCLAW_GATEWAY_TOKEN=

# Alternative: Use password instead of token
# OPENCLAW_GATEWAY_PASSWORD=

# Gateway binding (lan, all, or 127.0.0.1)
OPENCLAW_GATEWAY_BIND=lan

# Gateway ports
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_MSTEAMS_PORT=3978

# Allow insecure WebSocket connections (development only)
OPENCLAW_ALLOW_INSECURE_PRIVATE_WS=0

# Disable Bonjour/mDNS in containers (recommended)
OPENCLAW_DISABLE_BONJOUR=1

# =============================================================================
# OLLAMA (FREE LOCAL AI) - Primary AI Provider
# =============================================================================

# Ollama running on host PC (not in Docker)
# Make sure Ollama is installed and running: ollama serve
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=ollama-local

# =============================================================================
# WEBHOOKS (Optional)
# =============================================================================

OPENCLAW_WEBHOOK_TOKEN=webhook-secret-12345

# =============================================================================
# AI MODEL PROVIDERS (Optional - only if you have API keys)
# =============================================================================

# OpenAI (GPT models) - OPTIONAL
OPENAI_API_KEY=

# Anthropic (Claude models) - OPTIONAL
ANTHROPIC_API_KEY=

# Google Gemini - OPTIONAL
GEMINI_API_KEY=

# OpenRouter - OPTIONAL
OPENROUTER_API_KEY=

# =============================================================================
# MESSAGING CHANNELS (Optional)
# =============================================================================

# Telegram - Get token from @BotFather
TELEGRAM_BOT_TOKEN=

# Discord - Get from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# Timezone
OPENCLAW_TZ=Asia/Taipei

# Docker image name
OPENCLAW_IMAGE=openclaw:local

# =============================================================================
# NOTES FOR LOCAL DEVELOPMENT
# =============================================================================
# 
# 1. Install Ollama on your host PC:
#    Download from: https://ollama.com/download
#    Start: ollama serve
#    Pull a model: ollama pull llama2
#
# 2. Access OpenClaw:
#    http://localhost:8090 (via Nginx)
#    http://localhost:18789 (direct to gateway)
#
# 3. Generate secure gateway token:
#    openssl rand -hex 32
#
# 4. Data persistence:
#    All data stored in ./data/ directory:
#    - ./data/config - Configuration files
#    - ./data/workspace - Workspace files
#    - ./data/secrets - Auth secrets
#
# 5. No paid API keys needed!
#    Use Ollama for free local AI models
#

